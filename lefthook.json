{
  "$schema": "https://raw.githubusercontent.com/evilmartians/lefthook/master/schema.json",
  "pre-commit": {
    "commands": {
      "format": {
        "run": "npm run format {staged_files}",
        "glob": ["*.{js,jsx,ts,tsx,json,css,html,md}"],
        "stage_fixed": true
      },
      "lint": {
        "run": "npm run lint {staged_files}",
        "glob": ["*.{js,jsx,ts,tsx}"]
      },
      "type-check": {
        "run": "npx tsc --noEmit -p ./tsconfig.lib.json && npx tsc --noEmit -p tsconfig.node.json",
        "glob": ["*.{ts,tsx}"]
      },
      "test-related": {
        "run": "npm run test:related {staged_files}",
        "glob": ["*.{js,jsx,ts,tsx}"]
      }
    }
  },
  "commit-msg": {
    "commands": {
      "lint-msg": {
        "run": "npx commitlint --edit {1}"
      }
    }
  },
  "pre-push": {
    "commands": {
      "build": {
        "run": "npm run build"
      }
    }
  }
}
